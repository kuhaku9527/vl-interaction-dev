# Python caches and build output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Workspace-local cache (workspace-isolation convention: agent/tool caches only
# inside the working tree, never spill to D:/Cache, D:/tmp, etc.).
.cache/

# Agent-internal state (memory/skills/tmp under .workbuddy) and runtime PID dirs
# — local-only, never belong in VCS.
.workbuddy/
# Codex-side scratch dirs (see AGENTS.md §2):
#   .workbuddy_tmp/ - probe/fix scripts written by Codex during debugging
#   会话记录/       - one-off per-session JSON dump built from ~/.codex/sessions/
#                      (130+ MB; re-runnable via .workbuddy_tmp/extract_sessions.py)
.workbuddy_tmp/
会话记录/
services/.pids/

# Local virtual environments
.venv/
venv/
env/

# Local model weights and generated artifacts
models/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.ckpt
*.tar
*.tar.gz
*.zip
*.7z
*.rar
*.npy
*.npz
*.parquet
*.arrow
*.wav
*.mp3
*.flac
*.mp4
*.mov
*.webm

# Runtime logs, pid files, and temporary outputs
*.log
*.log.*
*.pid
*.out
*.err
nohup.out
logs/
run_logs/
**/logs/
**/run_logs/
tmp/
temp/
**/tmp/
**/temp/
result/
**/result/
result_v2/
**/result_v2/
summary_vllm_logs/
**/summary_vllm_logs/
html/
agent-workspace/
*.tmp
*.bak

# Local credentials and certificates
.env
.env.*
*.env
*.pem
*.key
*.crt
*.sqlite
*.db

# Per-deploy webui services config (may contain api_key plaintext; persisted at
# runtime by PUT /api/services/config, chmod 0600, restart-safe). Local-only.
config/services.json
# Vector index sidecar (USearch HNSW) — regenerable local artifact produced by
# Local Wiki /v1/external/sync; never commit (companion to *.sqlite above).
*.usearch

# Generated test outputs are not uploaded from this combined workspace
test-results/
testing-results/
playwright-report/
coverage/
coverage.xml
**/tests/real_envs/
**/tests/.venv/
**/tests/tmp/

# Background agent local state. Keep the directory, ignore its contents.
**/codex-home/**
!**/codex-home/
!**/codex-home/.gitkeep

# --- v3.24 cleanup ---
# Top-level runtime / agent local state directories.
/.pids/
/.pytest_cache/
/.agents/

# Subpackage build / cache artefacts not already covered.
/**/.pytest_cache/
/**/*.egg-info/

# Voice clone audio payloads (ref.wav / ref_*.wav) are large and rebuilt
# locally; keep transcripts and meta.json. Re-run cloning to regenerate.
services/voice-clone/voices/**/*.wav

# Intentionally archived one-off scripts / debug artifacts (moved from repo root
# into archive/ on 2026-07-20 for root-dir cleanup). Kept in VCS for traceability.
!archive/**
!/archive

# Surgical OSS cleanup (2026-08-11): archive debug logs are volatile one-off
# traces, not useful for traceability. Keep them out of VCS even though archive/
# is force-tracked above. One-off scripts/json under archive/ stay tracked.
archive/**/*.log

# Top-level historical PDF / zip review artefacts.
/*.pdf
/*.zip

# Debug / launcher log dir used by the orchestrator; per-launch traces only.
/services/.logs/

# Node / npm (frontend lint tooling under services/webui)
node_modules/

# Drift Gate runtime probe output (regenerated by scripts/vlm_runtime_probe.py)
logs/vlm-runtime-props.json
services/.logs/*.log
services/.logs/*.err.log
