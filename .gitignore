# Python caches and build output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Workspace-local cache (workspace-isolation convention: agent/tool caches only
# inside the working tree, never spill to D:/Cache, D:/tmp, etc.).
.cache/

# Agent-internal state (memory/skills/tmp under .workbuddy) and runtime PID dirs
# — local-only, never belong in VCS.
#   这些目录属【历史 agent 环境】（WorkBuddy / Codex），当前环境为 DSH。
#   仍保留忽略规则：目录内容仍在磁盘上（含历史决策旁证），且不应进版本控制。
#   背景见 doc/history-agent-environments.md 与 doc/environment-dsh.md。
.workbuddy/
#   会话记录/       - one-off per-session JSON dump（130+ MB，已不产生新内容）
.workbuddy_tmp/
会话记录/
services/.pids/

# Local virtual environments
.venv/
venv/
env/

# Local model weights and generated artifacts
models/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.ckpt
*.tar
*.tar.gz
*.zip
*.7z
*.rar
*.npy
*.npz
*.parquet
*.arrow
*.wav
*.mp3
*.flac
*.mp4
*.mov
*.webm

# Runtime logs, pid files, and temporary outputs
*.log
*.log.*
*.pid
*.out
*.err
nohup.out
logs/
run_logs/
**/logs/
**/run_logs/
tmp/
temp/
**/tmp/
**/temp/
result/
**/result/
result_v2/
**/result_v2/
summary_vllm_logs/
**/summary_vllm_logs/
html/
agent-workspace/
*.tmp
*.bak

# Local credentials and certificates
.env
.env.*
*.env
*.pem
*.key
*.crt
*.sqlite
*.db

# Per-deploy webui services config (may contain api_key plaintext; persisted at
# runtime by PUT /api/services/config, chmod 0600, restart-safe). Local-only.
config/services.json
# Named connection profiles (2026-09-18, A2-b): backend-persisted connection list
# for LLM / summary / embedding / asr / tts. Also carries api_key plaintext
# (same security baseline as services.json, E3 by user decision) — must never
# be committed. Written by PUT /api/connections.
# 连同原子写用的临时文件（tempfile 前缀 .connections-*.tmp）一起忽略，
# 否则写入过程中崩溃会留下一个含明文 key 的孤儿文件。
config/connections.json
config/.connections-*.tmp
# Vector index sidecar (USearch HNSW) — regenerable local artifact produced by
# Local Wiki /v1/external/sync; never commit (companion to *.sqlite above).
*.usearch

# Generated test outputs are not uploaded from this combined workspace
test-results/
testing-results/
playwright-report/
coverage/
coverage.xml
**/tests/real_envs/
**/tests/.venv/
**/tests/tmp/

# Background agent local state. Keep the directory, ignore its contents.
**/codex-home/**
!**/codex-home/
!**/codex-home/.gitkeep

# --- v3.24 cleanup ---
# Top-level runtime / agent local state directories.
/.pids/
/.pytest_cache/
/.agents/

# Subpackage build / cache artefacts not already covered.
/**/.pytest_cache/
/**/*.egg-info/

# Voice clone audio payloads (ref.wav / ref_*.wav) are large and rebuilt
# locally; keep transcripts and meta.json. Re-run cloning to regenerate.
services/voice-clone/voices/**/*.wav

# Intentionally archived one-off scripts / debug artifacts (moved from repo root
# into archive/ on 2026-07-20 for root-dir cleanup). Kept in VCS for traceability.
!archive/**
!/archive

# Surgical OSS cleanup (2026-08-11): archive debug logs are volatile one-off
# traces, not useful for traceability. Keep them out of VCS even though archive/
# is force-tracked above. One-off scripts/json under archive/ stay tracked.
archive/**/*.log

# Top-level historical PDF / zip review artefacts.
/*.pdf
/*.zip

# Debug / launcher log dir used by the orchestrator; per-launch traces only.
/services/.logs/

# Node / npm (frontend lint tooling under services/webui)
node_modules/

# Wind Alice deep-research CLI workspace session state (2026-08-12): per-workspace
# contextId continuation cache, volatile, not project source.
/.wind-alice/

# Drift Gate runtime probe output (regenerated by scripts/vlm_runtime_probe.py)
logs/vlm-runtime-props.json
services/.logs/*.log
services/.logs/*.err.log

# Agent-authored local artifacts (2026-09-16), local-only, not project source:
#   doc/frontend/diagrams/ - archify 生成的流程图（规格 JSON + 交付 HTML +
#                            visual-check 截图/回执），可由规格随时重新渲染。
#   memory/                - DSH 按 AGENTS.md 约定追加的每日工作留痕
#                            （目标/做了什么/踩的坑/验证结果/遗留）。
/doc/frontend/diagrams/
/memory/
scripts/.fs-inspect/
# scripts/webui-invariants.mjs 的基线快照（本机结构守恒比对用，随时可 --save 重建）
scripts/.invariants.json

# 迁移/排障用的临时备份与分块（一次性，可重建）
scripts/.*.bak.css
scripts/.index-before-*.html
scripts/.blk*.css
scripts/.head-index.html

# iDesign Studio 会话镜像（由 scripts/idesign-wire.mjs 生成，含 sessionId，不应入库）
/design/session-*/

# AgentTeams 运行时团队状态（2026-09-19 补）：
#   .agent-teams/<team>/{team.json, inbox/*.jsonl}
#   —— 是**本机协作运行时状态**（含成员对话留痕），非项目源码；
#      任务结束后由 agent_teams_delete 归档，也不应进入版本历史。
#   ⚠️ 曾误以为它已被忽略（`git check-ignore` 返回 rc=1 被错读成"已忽略"，
#      实际 rc=1 的含义是"**没有**匹配任何忽略规则"）。实测 `git add -A`
#      会带入 5 个文件，故在此显式忽略。
/.agent-teams/

# deepsec 扫描快照：每次扫描都重新生成，且是**当时那一刻**的过时视图，
# 入库后易被后审误读为当前状态（真实门禁以 pre-commit hook 实时扫描为准）。
/deepsec-report.json
