# JoyAI-VL-Interaction :: run-windows.env (example)
# Loaded by services\scripts\run-windows.ps1.
# Copy this file to run-windows.env and edit values for your machine.

# ---------------------------------------------------------------------------
# Root locations
# ---------------------------------------------------------------------------
JOYAI_BIN_ROOT=D:\AI\bin
JOYAI_MODELS_ROOT=D:\AI\models
JOYAI_TOOLS_ROOT=D:\AI\tools
# JOYAI_VENV_PY=D:\path\to\your\venv\python.exe   # commented: machine-specific; uncomment & set for YOUR env (the loader may fall back to this .example template)

# Override any individual binary explicitly. Leave blank to use the defaults
# relative to JOYAI_BIN_ROOT.
# LLAMA_SERVER=D:\AI\bin\llama.cpp\llama-server.exe
# WHISPER_SERVER=D:\AI\bin\whisper.cpp\whisper-server.exe
# HERMES_EXE=%LOCALAPPDATA%\hermes\bin\hermes.cmd

# ---------------------------------------------------------------------------
# Ports (match the original Linux deployment)
# ---------------------------------------------------------------------------
# MAIN_MODEL_PORT=7060          # llama-server main (JoyAI-VL-Interaction)
# SUMMARY_PORT=8065             # llama-server summary (Qwen2.5-VL-3B)
# ADAPTER_PORT=8070             # webinfer live adapter
# CODEX_API_PORT=8079           # background-agent shim
# WEBUI_PORT=8099               # webui (http://127.0.0.1 only)
# HERMES_GATEWAY_PORT=8642      # hermes-agent gateway
# VOICE_CLONE_PORT=8985         # voice-clone API
# ASR_MODEL_PORT=8993           # whisper.cpp server
# ASR_ADAPTER_PORT=8994         # asr-adapter

# ---------------------------------------------------------------------------
# Main model (llama-server)
# ---------------------------------------------------------------------------
MAIN_CONTEXT=16384
# v3.34: webinfer prompt guard 预算(单位 token,同步 llama-server -c)。
# webinfer 在 _build_main_http_messages 里按 main_ctx_tokens * 3 chars * 0.85 算总字符预算,
# 超过就把最老的 user/assistant turn 裁掉,避免 llama-server 400 exceed_context_size_error。
MAIN_CTX_TOKENS=16384
# MAIN_EXTRA_ARGS=--slots --batch-size 512

# Summary model (llama-server)
# SUMMARY_CONTEXT=8192
# SUMMARY_EXTRA_ARGS=

# whisper.cpp
# WHISPER_EXTRA_ARGS=


# voice-clone API
# VOICES_DIR=D:\AI\workspace\JoyAI-VL-Interaction-main\services\voice-clone\voices
# VOICE_CLONE_EXTRA_ARGS=

# Hermes-agent gateway
HERMES_API_KEY=replace-me-with-a-long-random-string
# The matching API key must also be in background-agent.env (HERMES_API_KEY=...).

# background-agent (hermes shim)
# CODEX_API_MAX_SUBAGENTS=6
# BG_AGENT_EXTRA_ARGS=

# webinfer
# FRAME_SAVE_DIR=C:\AI\frames
# SYSTEM_PROMPT=D:\AI\workspace\JoyAI-VL-Interaction-main\prompts\bt-7274.txt
# CHARACTER_PROMPT_PATH=D:\AI\workspace\JoyAI-VL-Interaction-main\prompts
# WEBINFER_EXTRA_ARGS=


# asr-adapter
# ASR_ADAPTER_EXTRA_ARGS=

# webui
# WEBUI_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Cross-cutting behaviour
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR
# FORCE_SILENCE_BEFORE_QUERY=false   # auto-set in 'gaming' mode; do not edit otherwise

# ---------------------------------------------------------------------------
# GPU memory budget (informational; not all args are passed to llama-server)
# Each llama-server defaults: -ngl 999  (offload every layer)
# The current default starts only the main community-quantized model on GPU.
# ---------------------------------------------------------------------------
# MAIN_GPU_LAYERS=999
# SUMMARY_GPU_LAYERS=999
# ---------------------------------------------------------------------------
# BT-7274 voice clone (MiniMax Rapid Clone, 2026-07-11 upgrade)
# Reference audio upgraded to bt_reference.wav (23.24 s, 16 kHz mono).
# ---------------------------------------------------------------------------
# MiniMax Rapid Clone credentials (REQUIRED for re-clone at start; see doc/voice-clone.md)
# Keep MINIMAX_API_KEY in the User/Process environment; do not commit it here.
# PowerShell: [Environment]::SetEnvironmentVariable('MINIMAX_API_KEY','sk-cp-...','User')
MINIMAX_GROUP_ID=<your_minimax_group_id>
TTS_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_DEFAULT_MODEL=speech-2.8-hd
MINIMAX_LANGUAGE_BOOST=Chinese

# MiniMax cloud voice used by WebUI/Jarvis direct synthesis.
# Step-by-step management commands are in doc/voice-clone.md.
TTS_DEFAULT_VOICE_ID=minimax_man_33333

# ---------------------------------------------------------------------------
# SiliconFlow (optional cloud provider for memory-store + ASR)
# Domestic-reachable, L0 free tier. Keep key in User/Process env or this file
# (this file is gitignored). Do NOT commit keys.
# ---------------------------------------------------------------------------
# SILICONFLOW_API_KEY=sk-...

# ASR cloud option: point the adapter at SiliconFlow instead of local vLLM.
# Default model: SenseVoiceSmall (multilingual, auto LID, emotion/audio-event).
# Alternative: TeleAI/TeleSpeechASR (faster, Mandarin + 60 dialects, industrial).
# ASR_UPSTREAM_URL=https://api.siliconflow.cn/v1/audio/transcriptions
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# ASR_API_KEY=${SILICONFLOW_API_KEY}

# ---------------------------------------------------------------------------
# Jarvis mode (KWS / ASR / LLM / TTS / events)
# Model directory uses bt-en (clean English BPE tokens B/T) ? renamed from
# bt-en on 2026-07-11 because keywords are 2 token English "B T @bt".
# ---------------------------------------------------------------------------
JARVIS_KWS_MODEL_DIR=D:/AI/models/sherpa-onnx/models/kws/bt-en
JARVIS_ASR_MODEL_DIR=D:/AI/models/sherpa-onnx/models/asr/streaming-paraformer-bilingual-zh-en
JARVIS_EVENTS_DIR=D:/AI/workspace/JoyAI-VL-Interaction-main/prompts/bt/events

# Dialog ASR provider for jarvis + live modes (spec draft-asr-provider-unified.md).
#   local (default) -> local sherpa streaming-paraformer (zero behavior change);
#   cloud           -> OpenAI-compatible /v1/audio/transcriptions upstream
#                      (reuses ASR_UPSTREAM_URL / ASR_API_KEY / ASR_MODEL above;
#                      no partials -> subtitles empty, EXIT_WORD check moves to
#                      the final; upstream unreachable is an explicit error unless
#                      JARVIS_ASR_ALLOW_LOCAL_FAILOVER=1 degrades to local).
JARVIS_ASR_PROVIDER=local

# KWS sweet-spot for clean 16 kHz mono mic (voice-clone.md ?13 environment):
#   th=0.25 (2026-08-12 B1 P0 restored from 0.20: sweep shows 0.20 gives no
#   recall gain; 0.25 removes a slice of silent-false-wake FAR at zero recall cost)
#   If recall too low  -> lower threshold to 0.20 OR raise score to 12
#   If FAR too high    -> raise threshold to 0.30 OR drop score to 8
JARVIS_KWS_SCORE=10.0
JARVIS_KWS_THRESHOLD=0.25
JARVIS_KWS_TRAILING_BLANKS=1
JARVIS_KWS_MAX_ACTIVE_PATHS=10

# LLM gateway (v3.37 single-entry point: voice + video + paper-plane all go through webinfer :8070)
# JARVIS_LLM_API_URL: leave unset to use the dataclass default (http://127.0.0.1:8070/v1).
# Only override if pointing at a remote/special webinfer instance.
# (jarvis_mode.JarvisConfig.llm_text_path=/text/chat, llm_multimodal_path=/chat/completions)
# JARVIS_LLM_API_URL=http://127.0.0.1:8070/v1
JARVIS_LLM_MODEL=joyai-vl-interaction-preview-iq4_nl-imat.gguf

# TTS (voice_clone_api on :8985)
JARVIS_TTS_API_URL=http://127.0.0.1:8985/v1/synthesize
JARVIS_TTS_VOICE_ID=minimax_man_33333

# Turn-controller integration gates (see doc/specs/turn-controller-integration.md):
#   JARVIS_TURN_SHADOW_ENABLED  (Phase A, observe-only) — default OFF; ON for
#     shadow alignment runs. Logs appear as "[turn-shadow]" lines. Kept as the
#     regression observation tool after Phase B landed (decision D-2026-08-13-TC2).
#   JARVIS_TURN_DELEGATE_ENABLED (Phase B, DIALOG_ACTIVE arbitration) — default
#     OFF = legacy path, byte-for-byte unchanged (production safe baseline).
#     Enable ONLY after real-device regression passes (wake/commit/barge-in/exit
#     unchanged; decision D-2026-08-13-TC1). Logs: "[turn-delegate]" lines.
# JARVIS_TURN_SHADOW_ENABLED=false
# JARVIS_TURN_DELEGATE_ENABLED=false

# ---------------------------------------------------------------------------
# memory-store (v0.3, 2026-07-29) — 端口铁律 D-L4-001
# 决策态：真后端 :8997（bge-m3 语义召回，#36）；:8996 是废弃空壳（仅作 default-fallback）。
# 启动脚本走 8997 默认；webinfer / webui 网关通过 JOYAI_MEMORY_STORE_URL 注入。
# 关闭其中任一行即恢复旧的 opt-in / 错端口行为。
# ---------------------------------------------------------------------------
MEMORY_PORT=8997
# Both env keys needed: webinfer reads MEMORY_STORE_URL (memory_store_client.py:88);
# webui server.py:958 reads JOYAI_MEMORY_STORE_URL. Same value, two names.
MEMORY_STORE_URL=http://127.0.0.1:8997
JOYAI_MEMORY_STORE_URL=http://127.0.0.1:8997
JOYAI_ENABLE_MEMORY_STORE=1
# Provider: "local" (offline-first, default) or "siliconflow" (cloud, L0 free tier).
# EMBEDDING_PROVIDER=local

